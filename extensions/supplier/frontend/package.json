{
  "name": "sub2api-supplier-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "engines": { "node": ">=20.19.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm run test:run && pnpm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "test:run": "vitest run"
  },
  "dependencies": {
    "vue": "3.5.43",
    "vue-i18n": "9.14.5"
  },
  "devDependencies": {
    "@types/node": "20.19.27",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/test-utils": "2.4.6",
    "jsdom": "24.1.3",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vitest": "2.1.9",
    "vue-tsc": "2.2.12"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.18": ">=8.5.18",
      "source-map-js@<1.2.2": ">=1.2.2"
    }
  }
}
