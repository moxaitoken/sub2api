# Supplier-only database. Never use the primary sub2api database or credentials.
SUPPLIER_DATABASE_URL=postgres://SUPPLIER_USER:SUPPLIER_PASSWORD@127.0.0.1:5432/sub2api_supplier?sslmode=disable
SUPPLIER_UPSTREAM_URL=http://127.0.0.1:8080
SUPPLIER_UPSTREAM_INSTANCE_ID=UPSTREAM_INSTANCE_UUID
SUPPLIER_UPSTREAM_SOURCE_SHA=UPSTREAM_SOURCE_SHA_40_HEX
SUPPLIER_PUBLIC_ORIGIN=https://SUPPLIER_HOST
SUPPLIER_SESSION_KEY_BASE64=INDEPENDENT_32_BYTE_KEY_BASE64
SUPPLIER_SESSION_KEY_ID=supplier-session-v1
SUPPLIER_LISTEN=127.0.0.1:8091
# Keep false except explicit isolated localhost development.
SUPPLIER_INSECURE_LOCALHOST=false
# Empty by default. Add only actual reverse proxy source IPs, never 0.0.0.0/0.
SUPPLIER_TRUSTED_PROXIES=
# Optional static build directory owned by this module only.
SUPPLIER_STATIC_DIR=
# Server-only management key. Empty disables account writes; never put it in Vue env.
SUPPLIER_ADMIN_API_KEY=
SUPPLIER_QUARANTINE_GROUP_ID=
SUPPLIER_APPROVED_GROUP_IDS=
SUPPLIER_IDENTITY_KEY_BASE64=
SUPPLIER_IDENTITY_KEY_ID=
