# Copy to /opt/sub2api/production.env; restrict to mode 0600.
# Fill every REQUIRED value; never commit the real production.env.
SUB2API_IMAGE=sub2api-local:b12696932788-local
DATABASE_HOST=REQUIRED
DATABASE_PORT=5432
DATABASE_USER=REQUIRED
DATABASE_PASSWORD=REQUIRED
DATABASE_DBNAME=sub2api
DATABASE_SSLMODE=disable
DATABASE_MAX_OPEN_CONNS=50
DATABASE_MAX_IDLE_CONNS=10
REDIS_HOST=REQUIRED
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=REQUIRED
REDIS_DB=0
REDIS_ENABLE_TLS=false
REDIS_POOL_SIZE=128
REDIS_MIN_IDLE_CONNS=10
ADMIN_EMAIL=REQUIRED
ADMIN_PASSWORD=REQUIRED
JWT_SECRET=REQUIRED
TOTP_ENCRYPTION_KEY=REQUIRED
# Private bootstrap only. Before enabling host Caddy, add the observed Docker
# gateway /32 to this list; see DEPLOYMENT.md. Never trust the whole bridge subnet.
SERVER_TRUSTED_PROXIES=127.0.0.1/32
TZ=Asia/Shanghai
